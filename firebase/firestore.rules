rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gameSaves/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validSave() {
        return request.resource.data.keys().hasOnly(['version', 'payload', 'revision', 'updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 120000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list: if false;
      allow create: if owner() && validSave() && request.resource.data.revision == 1;
      allow update: if owner() && validSave()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
